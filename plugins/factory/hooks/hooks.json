{
  "description": "factory: keep E2E and emulator runs in the final verify",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_slow_checks.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
